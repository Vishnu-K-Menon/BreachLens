# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/

# Secrets (commit .env.example only)
.env

# Generated data (never committed; ADR-044)
data/output/*
!data/output/.gitkeep
data/cache/*
!data/cache/.gitkeep
# The Census cache is committed (synthetic addresses only) so a fresh clone gets real
# address statuses offline (README); temp files from interrupted writes are not.
!data/cache/census/
data/cache/census/*.tmp
data/raw/corpus_v1/
data/raw/column_corpus/
data/raw/corpus_holdout/
data/raw/scale/*
!data/raw/scale/.gitkeep

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Jupyter artifacts (notebooks/ itself is the human's work and is never staged by the agent)
.ipynb_checkpoints/
.virtual_documents/

# The one-time macro shell used to produce excel/vbaProject.bin (EXCEL_WORKBOOK.md)
excel/macro_shell.xlsm

# Trained models are regenerated by `breachlens train` (ADR-057); cards/metrics/plots are committed
models/*.joblib
~$*
